# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# PostgreSQL (native install — not Docker)
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Test database URL (used by the test Spring profile)
DB_TEST_URL=jdbc:postgresql://localhost:5432/ecommerce_test

# Redis (runs via Docker — see docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Razorpay Payment Gateway (leave blank if using mock provider)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_VPA=
